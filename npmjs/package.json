{
  "name": "@tomasko/mb",
  "version": "0.1.7",
  "description": "A MoonBit-native, uv-style toolchain and package manager: manage MoonBit toolchains and install tools from github and mooncakes.io.",
  "license": "Apache-2.0",
  "bin": {
    "mb": "bin/mb.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "files": [
    "bin/mb.js",
    "install.js",
    "lib.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tomasky/mb.git"
  },
  "homepage": "https://github.com/tomasky/mb",
  "bugs": "https://github.com/tomasky/mb/issues",
  "keywords": [
    "moonbit",
    "mooncakes",
    "toolchain",
    "package-manager",
    "uv"
  ],
  "preferGlobal": true
}
